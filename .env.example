# --- SERP provider -------------------------------------------------------
SERP_API_URL=https://serpapi.com/search.json
SERP_API_KEY=your_serp_api_key_here

# --- optional LLM fallback for `unknown` domains --------------------------
USE_LLM=false
LLM_PROVIDER=anthropic          # anthropic | gemini

# Only the key for the selected provider is needed.
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional: defaults to claude-sonnet-4-6 / gemini-2.5-flash per provider.
# LLM_MODEL=

# --- storage / networking -------------------------------------------------
DB_PATH=data/serp_monitor.sqlite3
HTTP_TIMEOUT=15
MAX_RETRIES=3
